SERVER_PORT=8080
PHYSICSPLAY_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
PHYSICSPLAY_DB_USER=postgres.your-project-ref
PHYSICSPLAY_DB_PASSWORD=your-database-password
APP_CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
PHYSICSPLAY_SUPABASE_API_KEY=your-supabase-secret-api-key
PHYSICSPLAY_GOOGLE_AI_API_KEY=your-google-ai-studio-api-key
